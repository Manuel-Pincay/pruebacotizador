# =============================================================================
# ERP — Variables de entorno
# =============================================================================
# 1. Copie este archivo a .env (no commitear .env):
#      Windows:  copy .env.example .env
#      Linux:    cp .env.example .env
# 2. Edite los valores marcados con [CAMBIAR]
# 3. Guía completa: docs/MYSQL_DEPLOYMENT.md
# =============================================================================

# ── Entorno ───────────────────────────────────────────────────────────────────
# development = pruebas local  |  production = servidor real
ERP_ENV=development

# ── Seguridad ─────────────────────────────────────────────────────────────────
# [CAMBIAR en producción] Clave para firmar cookies de sesión
# Generar: python -c "import secrets; print(secrets.token_hex(32))"
ERP_SECRET_KEY=erp-dev-secret-change-in-production

# [CAMBIAR en producción] Contraseña del panel /secretadmin
ERP_SECRETADMIN_PASSWORD=203211

# true = cookies solo por HTTPS (activar en producción con SSL/nginx)
ERP_COOKIE_SECURE=false

# Duración sesión usuario normal (segundos). Default: 7 días
ERP_SESSION_MAX_AGE=604800

# Duración sesión secretadmin (segundos). Default: 1 hora
ERP_ADMIN_SESSION_MAX_AGE=3600

# Registros por página en listados
ERP_PER_PAGE=20

# ── Base de datos MySQL ───────────────────────────────────────────────────────
# Formato: mysql+pymysql://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE?charset=utf8mb4
#
# Si la base no existe, iniciar_servidor.bat la crea automaticamente.
#
# Ejemplo local:
DATABASE_URL=mysql+pymysql://admin:admin123@127.0.0.1:3306/erp?charset=utf8mb4
#
# Alternativa con usuario dedicado:
# DATABASE_URL=mysql+pymysql://erp_user:erppassword@127.0.0.1:3306/erp?charset=utf8mb4

# Pool de conexiones (solo MySQL)
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=40
DB_POOL_RECYCLE=3600

# ── Facturación SRI ───────────────────────────────────────────────────────────
# Cifrado AES-256-GCM para certificado .p12 y contraseña (64 hex = 32 bytes)
# Generar: python -c "from app.utils.encryption import generate_encryption_key; print(generate_encryption_key())"
ERP_ENCRYPTION_KEY=

# ── Correo SMTP (facturas PDF/XML + códigos de verificación de tienda) ────────
# Prioridad: configuración en UI (secretadmin → Correo SMTP / Facturación SRI).
# Si no hay nada en BD, se usan estas variables.
# SMTP_ENABLED=true
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USER=su_correo@gmail.com
# SMTP_PASSWORD=contraseña_de_aplicacion
# SMTP_FROM=su_correo@gmail.com

# Cookies de sesión legacy (username en texto / token "authenticated")
# Solo para migración; dejar en false.
# ERP_ALLOW_LEGACY_SESSION=false
# Token del bot (@BotFather). Los destinatarios se configuran en Usuarios → Admin
# (Chat ID + “Recibir notificaciones”). Solo rol admin.
# TELEGRAM_CHAT_ID del .env es fallback opcional si ningún admin tiene Telegram en BD.
# ENABLE_TELEGRAM=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# [CAMBIAR en producción]
# MYSQL_ROOT_PASSWORD=rootpassword_seguro
# MYSQL_PASSWORD=password_erp_user_seguro


